# Copy to .env on the VPS, chmod 600; never commit real values.
POSTIZ_DOMAIN=postiz.cmkia.com
POSTIZ_PUBLIC_ENABLED=false
POSTIZ_IMAGE=ghcr.io/gitroomhq/postiz-app:latest
POSTIZ_ROOT=/opt/app-postiz
POSTGRES_PASSWORD=replace-with-random-hex
TEMPORAL_POSTGRES_PASSWORD=replace-with-another-random-hex
JWT_SECRET=replace-with-at-least-64-random-hex-characters
